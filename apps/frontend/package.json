{
  "name": "weight-tracker",
  "description": "An app to track my own weight",
  "scripts": {
    "dev": "VITE_API_URL=http://localhost:3000/api pnpm vite",
    "build": "pnpm vite build",
    "lint": "pnpm run lint:prettier && pnpm run lint:oxlint && pnpm run lint:tsc",
    "lint:ci": "pnpm run lint:prettier-check && pnpm run lint:oxlint && pnpm run lint:tsc",
    "lint:prettier": "prettier --write src",
    "lint:prettier-check": "prettier --check src",
    "lint:oxlint": "oxlint src --deny-warnings",
    "lint:tsc": "tsc --noEmit",
    "lint:setup-hooks": "simple-git-hooks",
    "test": "vitest --run"
  },
  "author": "Grigoriy Levanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glevanov/weight-tracker.git"
  },
  "type": "module",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "pnpm --dir apps/frontend exec lint-staged && pnpm --dir apps/frontend run lint:tsc"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.3.1",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "happy-dom": "20.9.0",
    "oxlint": "1.67.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.1.0",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "jwt-decode": "4.0.0",
    "nanoid": "5.1.11",
    "svelte": "5.56.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "pnpm": {
    "allowBuilds": {
      "esbuild": true
    }
  }
}
