{
  "name": "weight-tracker",
  "description": "An app to track my own weight",
  "scripts": {
    "dev": "VITE_API_URL=http://localhost:3000/api pnpm vite",
    "build": "pnpm vite build",
    "lint": "pnpm run lint:prettier && pnpm run lint:oxlint && pnpm run lint:tsc",
    "lint:ci": "pnpm run lint:prettier-check && pnpm run lint:oxlint && pnpm run lint:tsc",
    "lint:prettier": "prettier --write src",
    "lint:prettier-check": "prettier --check src",
    "lint:oxlint": "oxlint src --deny-warnings",
    "lint:tsc": "tsc --noEmit",
    "lint:setup-hooks": "simple-git-hooks",
    "test": "vitest --run"
  },
  "author": "Grigoriy Levanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glevanov/weight-tracker.git"
  },
  "type": "module",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "pnpm --dir apps/frontend exec lint-staged && pnpm --dir apps/frontend run lint:tsc"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@testing-library/svelte": "5.3.1",
    "@typescript-eslint/eslint-plugin": "8.59.4",
    "@typescript-eslint/parser": "8.59.4",
    "happy-dom": "20.9.0",
    "oxlint": "1.66.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "4.0.1",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "jwt-decode": "4.0.0",
    "nanoid": "5.1.11",
    "svelte": "5.55.5"
  },
  "packageManager": "pnpm@11.0.9+sha512.34ce82e6780233cf9cad8685029a8f81d2e06196c5a9bad98879f7424940c6817c4e4524fb7d38b8553ceed48b9758b8ebaf1abd3600c232c4c8cf7366086f38",
  "pnpm": {
    "allowBuilds": {
      "esbuild": true
    }
  }
}
