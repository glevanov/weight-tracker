{
  "name": "weight-tracker",
  "description": "An app to track my own weight",
  "scripts": {
    "dev": "VITE_API_URL=http://localhost:3000/api pnpm vite",
    "build": "pnpm vite build",
    "build:gh-pages": "pnpm vite build --base /weight-tracker/",
    "lint": "pnpm run lint:prettier && pnpm run lint:oxlint && pnpm run lint:tsc",
    "lint:ci": "pnpm run lint:prettier-check && pnpm run lint:oxlint && pnpm run lint:tsc",
    "lint:prettier": "prettier --write src",
    "lint:prettier-check": "prettier --check src",
    "lint:oxlint": "oxlint src --deny-warnings",
    "lint:tsc": "tsc --noEmit",
    "lint:setup-hooks": "simple-git-hooks",
    "test": "vitest --run"
  },
  "author": "Grigoriy Levanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glevanov/weight-tracker.git"
  },
  "type": "module",
  "license": "MIT",
  "simple-git-hooks": {
    "pre-commit": "pnpm --dir apps/frontend exec lint-staged && pnpm --dir apps/frontend run lint:tsc"
  },
  "lint-staged": {
    "*.{js,ts,svelte}": [
      "prettier --write",
      "oxlint --fix --deny-warnings"
    ],
    "*.css": [
      "prettier --write"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.0.0",
    "@testing-library/svelte": "5.3.1",
    "@typescript-eslint/eslint-plugin": "8.59.0",
    "@typescript-eslint/parser": "8.59.0",
    "happy-dom": "20.8.9",
    "oxlint": "1.61.0",
    "prettier": "3.8.3",
    "prettier-plugin-svelte": "3.5.1",
    "typescript": "6.0.3",
    "vite": "8.0.10",
    "vitest": "4.1.5"
  },
  "dependencies": {
    "chart.js": "4.5.1",
    "jwt-decode": "4.0.0",
    "nanoid": "5.1.9",
    "svelte": "5.55.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
